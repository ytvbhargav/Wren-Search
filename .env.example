# Payload CMS — copy to .env and fill in real values.

# MongoDB connection string used by @payloadcms/db-mongodb
DATABASE_URI=mongodb+srv://user:password@cluster.example.mongodb.net/wrensearch

# Long random string used to sign Payload tokens/cookies (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=

# S3 bucket that stores uploaded media (team photos)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
